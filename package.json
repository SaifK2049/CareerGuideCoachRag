{
  "name": "orynta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check app.js && node --check admin.js && node --check report.js && node --check scripts/build.mjs && node --check scripts/import-esco-taxonomy.mjs && node scripts/verify-static.mjs",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo:reset": "node scripts/demo-data.mjs",
    "demo:stop": "npx supabase stop",
    "dev": "node scripts/demo-server.mjs",
    "monitor:production": "node scripts/production-smoke.mjs",
    "taxonomy:import:esco": "node scripts/import-esco-taxonomy.mjs",
    "test:career-os": "npx deno test --no-lock supabase/functions/_shared/career-planning_test.ts",
    "test:integration": "node scripts/integration-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6",
    "pdfjs-dist": "6.1.200",
    "tesseract.js": "5.1.1"
  }
}
